<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      .button-3 {
        appearance: none;
        background-color: #2ea44f;
        border: 1px solid rgba(27, 31, 35, 0.15);
        border-radius: 6px;
        box-shadow: rgba(27, 31, 35, 0.1) 0 1px 0;
        box-sizing: border-box;
        color: #fff;
        cursor: pointer;
        display: inline-block;
        font-family: -apple-system, system-ui, "Segoe UI", Helvetica, Arial,
          sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
        font-size: 14px;
        font-weight: 600;
        line-height: 20px;
        padding: 6px 16px;
        position: relative;
        text-align: center;
        text-decoration: none;
        user-select: none;
        -webkit-user-select: none;
        touch-action: manipulation;
        vertical-align: middle;
        white-space: nowrap;
      }

      .button-3:focus:not(:focus-visible):not(.focus-visible) {
        box-shadow: none;
        outline: none;
      }

      .button-3:hover {
        background-color: #2c974b;
      }

      .button-3:focus {
        box-shadow: rgba(46, 164, 79, 0.4) 0 0 0 3px;
        outline: none;
      }

      .button-3:disabled {
        background-color: #94d3a2;
        border-color: rgba(27, 31, 35, 0.1);
        color: rgba(255, 255, 255, 0.8);
        cursor: default;
      }

      .button-3:active {
        background-color: #298e46;
        box-shadow: rgba(20, 70, 32, 0.2) 0 1px 0 inset;
      }
    </style>
  </head>
  <body>
    <!-- HTML !-->
    <button class="button-3" role="button" onclick="upgradeSocket()">
      Upgrade Version
    </button>
    <button class="button-3" role="button" onclick="controlLamp()">
      Control Lamp
    </button>
    <button class="button-3" role="button" onclick="modDevLocation()">
      Modify Device Location
    </button>
    <button class="button-3" role="button" onclick="modDevName()">
      Modify Device Name
    </button>
    <button class="button-3" role="button" onclick="modLoginPasword()">
      Modify Login Password
    </button>
    <script>
      async function upgradeSocket() {
        let 
        try {
          const res = await fetch("/user/sendRequestSocket", {
            method: "POST",
            body:JSON.stringify({
              "data": {
              },
              "packetNo": "1234",
              "cmdType": "upgrade"
            })
          });
          const data = await res.json();
          console.log(data);
          alert("Upgrade Firmware Success!");
        } catch (error) {
          console.log(error);
          alert("Upgrade Firmware Failed!");
        }
      }
      async function controlLamp() {
        try {
          const res = await fetch("/user/sendRequestSocket", {
            method: "POST",
            body:JSON.stringify({
              "data": {
                "gatewayDn": "9E675FFEFF47B660",
                "deviceId": "-1",
                "switch" : "0",
              },
              "packetNo": "1234",
              "cmdType": "light"
            })
          });
          const data = await res.json();
          console.log(data);
          alert("Ordinary lamp control Success!");
        } catch (error) {
          console.log(error);
          alert("Ordinary lamp control Failed!");
        }
      }
      async function modDevLocation() {
        try {
          const res = await fetch("/user/sendRequestSocket", {
            method: "POST",
            body:JSON.stringify({
              "data": {
                "gatewayDn": "9E675FFEFF47B660",
                "deviceId": "-1",
                "location" : "Bedroom",
              },
              "packetNo": "1234",
              "cmdType": "deviceLocation"
            })
          });
          const data = await res.json();
          console.log(data);
          alert("Modify the Device Location Success!");
        } catch (error) {
          console.log(error);
          alert("Modify the Device Location Failed!");
        }
      }
      async function modDevName() {
        try {
          const res = await fetch("/user/sendRequestSocket", {
            method: "POST",
            body:JSON.stringify({
              "data": {
                "gatewayDn": "9E675FFEFF47B660",
                "deviceId": "-1",
                "name" : "Downlight",
              },
              "packetNo": "1234",
              "cmdType": "deviceName"
            })
          });
          const data = await res.json();
          console.log(data);
          alert("Modify the device name Success!");
        } catch (error) {
          console.log(error);
          alert("Modify the device name Failed!");
        }
      }
      async function modLoginPasword() {
        try {
          const res = await fetch("/user/sendRequestSocket", {
            method: "POST",
            body:JSON.stringify({
              "data": {
                "gatewayDn": "9E675FFEFF47B660",
                "password": "newPassword"
              },
              "packetNo": "1234",
              "cmdType": "changePassword"
            })
          });
          const data = await res.json();
          console.log(data);
          alert("Change the login password Success!");
        } catch (error) {
          console.log(error);
          alert("Change the login password Failed!");
        }
      }
    </script>
  </body>
</html>
